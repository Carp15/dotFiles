# User-level tool versions, managed by chezmoi.
# Edit this source state with `chezmoi edit ~/.config/mise/config.toml`, then
# review `chezmoi diff` before applying.

[tools]
go = "1.26.3"
{{/*
  Java vendor differs by platform, and only here: a TOML file cannot branch, and
  conf.d/*.toml cannot override a tool declared in this file (config.toml takes
  precedence). WSL starts on Temurin 21, which receives security updates; macOS
  keeps "21" (the unmaintained openjdk 21.0.2 build) until its own migration,
  tracked in docs/mise.md. Rendered output on macOS is unchanged.
*/ -}}
java = "{{ if eq (includeTemplate "platform" .) "wsl" }}temurin-21{{ else }}21{{ end }}"
node = "24"
npm = "11.15.0"
