# Interactive zsh setup shared across machines.

# Prefer user-installed CLI tools once, even when zprofile has already run.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
export PATH

# mise supplies language runtimes when it is installed on this machine.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"

  # Derive JAVA_HOME from mise's selected Java executable, if one is available.
  mise_java_bin="$(mise which java 2>/dev/null)"
  if [[ -n "$mise_java_bin" && -x "$mise_java_bin" ]]; then
    export JAVA_HOME="${mise_java_bin:A:h:h}"
  fi
  unset mise_java_bin
fi

# Neovim stands in for vim when it is installed. The guard keeps the real vim
# usable on machines without Neovim, instead of shadowing it with a broken alias.
if command -v nvim >/dev/null 2>&1; then
  alias vim='nvim'
fi

alias codexa='codex --profile auto'
alias codexf='codex --profile full'
