# Login-shell setup shared across macOS environments.

# Homebrew chooses a different default prefix on Apple Silicon and Intel Macs.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Keep user-installed CLI tools available without embedding a user-specific home.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
export PATH
